    {
        "id": "29c399074b05aa02",
        "type": "function",
        "z": "ff12b48d1cdd0a26",
        "name": "Montar INSERT jogador+personagens+inventario+partida",
        "func": "const b = msg.payload;\nmsg.query = [\n  \"WITH j AS (\",\n  \"  INSERT INTO jogador (nome, email) VALUES ($1, $2)\",\n  \"  ON CONFLICT (email) DO UPDATE SET nome = EXCLUDED.nome\",\n  \"  RETURNING id_jogador\",\n  \"),\",\n  \"sys AS (\",\n  \"  INSERT INTO jogador (nome, email) VALUES ('Sistema (Inimigos)', 'sistema@cerco.com')\",\n  \"  ON CONFLICT (email) DO UPDATE SET nome = EXCLUDED.nome\",\n  \"  RETURNING id_jogador\",\n  \"),\",\n  \"pj AS (\",\n  \"  INSERT INTO personagem (id_jogador, nome_batalha, classe, nivel, hp_maximo, hp_atual, ataque_basico, defesa)\",\n  \"  SELECT j.id_jogador, $3, $4, $5, $6, $6, $7, $8 FROM j\",\n  \"  RETURNING id_personagem\",\n  \"),\",\n  \"pi AS (\",\n  \"  INSERT INTO personagem (id_jogador, nome_batalha, classe, nivel, hp_maximo, hp_atual, ataque_basico, defesa)\",\n  \"  SELECT sys.id_jogador, $9, $10, $11, $12, $12, $13, $14 FROM sys\",\n  \"  RETURNING id_personagem\",\n  \"),\",\n  \"it AS (\",\n  \"  INSERT INTO item (nome, descricao, tipo, valor_efeito)\",\n  \"  VALUES ('Pocao de Cura', 'Restaura pontos de vida instantaneamente.', 'Cura Instantanea', 30)\",\n  \"  ON CONFLICT (nome) DO UPDATE SET nome = EXCLUDED.nome\",\n  \"  RETURNING id_item\",\n  \"),\",\n  \"inv AS (\",\n  \"  INSERT INTO inventario (id_personagem, id_item, quantidade)\",\n  \"  SELECT pj.id_personagem, it.id_item, $15 FROM pj, it\",\n  \"  RETURNING id_personagem\",\n  \")\",\n  \"INSERT INTO partida (id_desafiante, id_oponente, status)\",\n  \"SELECT pj.id_personagem, pi.id_personagem, 'Em Andamento' FROM pj, pi\",\n  \"RETURNING id_partida,\",\n  \"          (SELECT id_personagem FROM pj) AS id_personagem_jogador,\",\n  \"          (SELECT id_personagem FROM pi) AS id_personagem_inimigo;\"\n].join(\"\\n\");\nmsg.params = [\n  b.jogador.nome, b.jogador.email,\n  b.personagem.nome_batalha, b.personagem.classe, b.personagem.nivel || 1,\n  b.personagem.hp_maximo, b.personagem.ataque_basico, b.personagem.defesa,\n  b.inimigo.nome_batalha, b.inimigo.classe || 'Monstro', b.inimigo.nivel || 1,\n  b.inimigo.hp_maximo, b.inimigo.ataque_basico, b.inimigo.defesa,\n  (b.personagem.pocoes != null ? b.personagem.pocoes : 3)\n];\nreturn msg;",
        "outputs": 1,
        "x": 590,
        "y": 120,
        "wires": [
