    {
        "id": "49025ee5f3e21a66",
        "type": "function",
        "z": "ff12b48d1cdd0a26",
        "name": "Montar SELECT nome/hp/itens",
        "func": "const idPersonagem = msg.req.params.id_personagem;\nmsg.query = \"\\n  SELECT p.id_personagem, p.nome_batalha, p.hp_atual, p.hp_maximo,\\n         COALESCE(json_agg(json_build_object('id_item', i.id_item, 'nome', i.nome, 'tipo', i.tipo, 'quantidade', inv.quantidade))\\n                  FILTER (WHERE i.id_item IS NOT NULL), '[]') AS itens\\n  FROM personagem p\\n  LEFT JOIN inventario inv ON inv.id_personagem = p.id_personagem\\n  LEFT JOIN item i ON i.id_item = inv.id_item\\n  WHERE p.id_personagem = $1\\n  GROUP BY p.id_personagem;\\n\";\nmsg.params = [idPersonagem];\nreturn msg;",
        "outputs": 1,
